# SerpApi — Google Jobs search (server-only; never NEXT_PUBLIC_)
SERPAPI_API_KEY=

# Google Gemini — resume tailoring (server-only; never NEXT_PUBLIC_)
GEMINI_API_KEY=

# Notion — application tracker sync (server-only; never NEXT_PUBLIC_)
NOTION_TOKEN=
# Data source ID for your job applications table (required for sync)
NOTION_DATA_SOURCE_ID=
# Legacy fallback: if you only have one ID, it can go here instead
# NOTION_DATABASE_ID=

# Supabase (auth + per-user data)
# Browser-safe publishable values only:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key used to encrypt user-supplied API keys at rest.
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit a real key.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 hex characters (32 bytes). Losing this = losing every stored
# user key, so back it up.
ENCRYPTION_KEY=

# Owner email — the account that falls back to the env keys above instead of
# requiring per-user keys via the Settings page. Compared to the Auth session
# email, not profiles.email. Server-only. Never NEXT_PUBLIC_.
OWNER_EMAIL=
