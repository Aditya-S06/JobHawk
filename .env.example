# SerpApi — Google Jobs search
SERPAPI_API_KEY=

# Google Gemini — resume tailoring
GEMINI_API_KEY=

# Notion — application tracker sync
NOTION_TOKEN=
# Data source ID for your job applications table (required for sync)
NOTION_DATA_SOURCE_ID=
# Legacy fallback: if you only have one ID, it can go here instead
# NOTION_DATABASE_ID=

# Supabase (auth + per-user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key used to encrypt user-supplied API keys at rest.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 hex characters (32 bytes). Losing this = losing every stored
# user key, so back it up.
ENCRYPTION_KEY=

# Owner email — the account that falls back to the keys above instead of
# requiring per-user keys via the Settings page.
OWNER_EMAIL=
